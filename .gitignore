# Dados sensíveis e gerados em runtime — nunca versionar
oracle-checks-data.json
oracle-checks-unknown-log.json

# Dependências e cache
node_modules/
/vendor/
*.cache

# A biblioteca em lib/ é distribuída junto com o plugin: o vendor/ dela
# (Parsedown, PucReadmeParser) precisa ir no pacote, senão "Ver detalhes"
# e "Verificar atualizações" dão erro fatal.
!lib/**/vendor/

# Arquivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Zip de distribuição
*.zip

# Contexto local do projeto (memórias e preferências para o Claude Code)
CLAUDE.md